{
  "name": "leastcount-rush",
  "version": "1.0.0",
  "description": "Least Count Rush - Real-time multiplayer card game for 6 to 15 players",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scratch/test-features.js",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk": "npx cap sync android && cd android && gradlew.bat assembleDebug",
    "mobile:aab": "npx cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
